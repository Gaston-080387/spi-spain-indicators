ls(activity('nb_gold_refresh_sql_endpoint').Status, 'Succeeded'), equals(activity('scr_gold_load').Status, 'Succeeded')), string(coalesce(activity('scr_gold_load').output?.resultSets, json('[{\"rows\":[{}]}]'))[0].rows[0]?.rows_construction), 'NULL')}),\n      ('@{if(empty(pipeline().parameters.run_id), pipeline().RunId, pipeline().parameters.run_id)}',\n       'spi_pl_gold', 'gold', 'tax',\n       '@{if(and(equals(activity('nb_gold_refresh_sql_endpoint').Status, 'Succeeded'), equals(activity('scr_gold_load').Status, 'Succeeded')), 'success', 'failed')}',\n       '@{utcnow()}', '@{utcnow()}',\n       @{if(not(equals(activity('nb_gold_refresh_sql_endpoint').Status, 'Succeeded')), concat('LEFT(''SQL endpoint refresh: ', replace(string(activity('nb_gold_refresh_sql_endpoint').Error.message), '''', ''''''), ''', 4000)'), if(equals(activity('scr_gold_load').Status, 'Succeeded'), 'NULL', concat('LEFT(''', replace(string(activity('scr_gold_load').Error.message), '''', ''''''), ''', 4000)')))},\n       @{if(and(equals(activity('nb_gold_refresh_sql_endpoint').Status, 'Succeeded'), equals(activity('scr_gold_load').Status, 'Succeeded')), string(coalesce(activity('scr_gold_load').output?.resultSets, json('[{\"rows\":[{}]}]'))[0].rows[0]?.rows_tax), 'NULL')});",
