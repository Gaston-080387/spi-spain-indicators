                        "value": "@or(less(activity('lkp_gate_gold').output.firstRow.sources_logged, 5), greater(activity('lkp_gate_gold').output.firstRow.failed_count, 0))",
                        "type": "Expression"
                    },
                    "ifFalseActivities": [],
                    "ifTrueActivities": [
