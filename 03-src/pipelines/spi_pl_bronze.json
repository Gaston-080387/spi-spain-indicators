    "properties": {
        "activities": [
            {
                "name": "lkp_gate_bronze",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "inv_bronze_tax",
                        "dependencyConditions": [
                            "Completed"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "typeProperties": {
                    "source": {
                        "type": "DataWarehouseSource",
                        "sqlReaderQuery": {
                            "value": "@concat('SELECT COUNT(DISTINCT source) AS sources_logged, COALESCE(SUM(CASE WHEN status IN (''failed'',''running'') THEN 1 ELSE 0 END), 0) AS failed_count, COALESCE(STRING_AGG(CASE WHEN status IN (''failed'',''running'') THEN source END, '', ''), ''none'') AS failed_sources FROM dbo.spi_log_pipeline_execution WHERE layer = ''bronze'' AND run_id = ''', if(empty(pipeline().parameters.run_id), pipeline().RunId, pipeline().parameters.run_id), '''')",
                            "type": "Expression"
                        },
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "datasetSettings": {
                        "annotations": [],
                        "connectionSettings": {
                            "name": "spi_warehouse",
                            "properties": {
                                "annotations": [],
                                "type": "DataWarehouse",
                                "typeProperties": {
                                    "endpoint": "s75vfahvn26u3ixeltcyscwbvy-nbunaskuvb5u5balhvtpxiosji.datawarehouse.fabric.microsoft.com",
                                    "artifactId": "798e8494-dd44-4996-8212-44adb3661863",
                                    "workspaceId": "49d06868-a854-4e7b-840b-3d66fba1d24a"
                                },
                                "externalReferences": {
                                    "connection": "e22a81cb-07ae-4539-8765-fc89bcb0b94d"
                                }
                            }
                        },
                        "type": "DataWarehouseTable",
                        "schema": []
                    }
                }
            },
            {
